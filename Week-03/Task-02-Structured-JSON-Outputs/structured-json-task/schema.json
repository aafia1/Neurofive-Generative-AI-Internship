{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SupportTicketExtraction",
  "type": "object",
  "properties": {
    "name": {
      "type": ["string", "null"],
      "description": "Customer's full name, or null if not mentioned"
    },
    "email": {
      "type": ["string", "null"],
      "description": "Customer's email address, or null if not mentioned"
    },
    "issue_type": {
      "type": "string",
      "enum": ["billing", "technical", "account", "feature_request", "other"],
      "description": "Best-fit category for the reported issue"
    },
    "urgency": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"],
      "description": "How urgent the issue seems based on tone and content"
    },
    "summary": {
      "type": "string",
      "description": "One-sentence summary of the issue"
    }
  },
  "required": ["name", "email", "issue_type", "urgency", "summary"],
  "additionalProperties": false
}
